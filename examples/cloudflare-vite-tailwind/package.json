{
  "name": "hono-email-cloudflare-vite-tailwind-example",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "typegen": "wrangler types --config wrangler.jsonc && node strip-typegen-directives.mjs",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "dev": "vite",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.13.23",
    "hono-email": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.2",
    "@hono-email/tailwind-plugin": "workspace:*",
    "@tailwindcss/vite": "^4.3.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2",
    "wrangler": "^4.169.0"
  }
}
