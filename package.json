{
  "name": "hono-email-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*",
    "docs"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --filter './packages/*' build",
    "changeset": "changeset",
    "version": "bun run --filter hono-email update-caniemail && changeset version && bun run format",
    "release": "changeset publish",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "bun run build && bun run sync:docs && oxlint --disable-nested-config . && bun tools/lint/check-suppressions.mjs",
    "lint:types": "bun run lint",
    "sync:docs": "bun run --filter 'hono-email-docs' sync",
    "test": "bun test --path-ignore-patterns='_build' packages/core/src packages/tailwind-plugin/src packages/preview/src docs/src tools/lint",
    "test:coverage": "bun test --coverage --path-ignore-patterns='_build' packages/core/src packages/tailwind-plugin/src packages/preview/src docs/src tools/lint",
    "test:runtime": "bun run test:runtime:node && bun run test:runtime:deno && bun run test:runtime:bun && bun run test:runtime:cloudflare && bun run test:runtime:aws-ses",
    "test:runtime:aws-ses": "bun test runtime-tests/aws-ses/adapter.test.tsx",
    "test:runtime:node": "tsx --test runtime-tests/node/*.test.ts",
    "test:runtime:deno": "deno test --allow-net --allow-read runtime-tests/deno",
    "test:runtime:bun": "bun test runtime-tests/bun",
    "test:runtime:cloudflare": "vitest --run --config runtime-tests/cloudflare/vitest.config.ts",
    "typecheck": "bun run --filter './packages/*' typecheck"
  },
  "devDependencies": {
    "@aws-sdk/client-sesv2": "^3.1179.0",
    "@changesets/changelog-github": "^2.0.0",
    "@changesets/cli": "^3.1.0",
    "@cloudflare/vitest-plugin": "^1.10.0",
    "@cloudflare/workers-types": "^5.20261128.1",
    "@types/bun": "^1.4.5",
    "@types/deno": "2.7.0",
    "@types/node": "^26.6.11",
    "hono": "^4.13.23",
    "oxc-parser": "0.160.0",
    "oxfmt": "^0.80.0",
    "oxlint": "1.95.0",
    "tsdown": "^0.23.7",
    "tsrs": "7.1.0-beta.tsrs5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "unplugin": "^3.7.0",
    "unplugin-isolated-decl": "^0.17.0",
    "vitest": "^5.1.2"
  },
  "overrides": {
    "@types/node": "^26.6.11",
    "fast-uri": "^3.1.9",
    "postcss": "^8.5.34",
    "svgo": "^4.1.0",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "bun@1.4.5",
  "patchedDependencies": {
    "mdast-util-from-markdown@2.1.0": "patches/mdast-util-from-markdown@2.1.0.patch",
    "micromark@4.0.3": "patches/micromark@4.0.3.patch",
    "decode-named-character-reference@1.3.0": "patches/decode-named-character-reference@1.3.0.patch"
  }
}
